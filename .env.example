# Required. Use the Postgres URL from Railway / Render / your VPS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional. Protect the app with a password (you will see a login screen).
# APP_PASSWORD=pick-a-long-password

# Optional extra secret for login cookies. Any long random string is fine.
# SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Lets the app encrypt extra secrets stored in the database (32-byte base64).
# ENCRYPTION_KEY=

# --- Live trading (leave these OFF until paper mode looks good for weeks) ---
# LIVE_TRADING_ENABLED=true

# Alpaca (stocks + crypto). Paper host is used unless ALPACA_PAPER=false.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_PAPER=true

# Robinhood official API is CRYPTO ONLY.
# ROBINHOOD_API_KEY=
# ROBINHOOD_BASE64_PRIVATE_KEY=

# Optional language models for the assistant (the app works without them).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=

# How often the trading agent runs (milliseconds). Default 60000 = 1 minute.
# AGENT_INTERVAL_MS=60000
